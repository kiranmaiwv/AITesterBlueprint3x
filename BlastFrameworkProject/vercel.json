{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install && (pip install --break-system-packages -r requirements.txt || pip install -r requirements.txt)",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "env": {
    "PYTHON_VERSION": "3.12"
  }
}
