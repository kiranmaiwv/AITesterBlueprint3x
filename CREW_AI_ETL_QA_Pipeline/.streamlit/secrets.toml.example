# Streamlit Community Cloud secrets. Key names match .env exactly; app.py
# copies them into the environment before configuration is read.
APP_NAME = "Healthcare ETL QA Crew"
APP_ENV = "production"
OUTPUT_DIR = "outputs"
LOG_LEVEL = "INFO"
DEMO_MODE = "true"

# LLM (CrewAI)
LLM_MODEL = "deepseek/deepseek-v4-flash"
LLM_API_KEY = ""
LLM_BASE_URL = ""
LLM_TEMPERATURE = "0.1"
LLM_MAX_TOKENS = "8000"
LLM_STRUCTURED_OUTPUT = "auto"

# Data source
DATA_SOURCE_MODE = "fixture"
DATA_ENGINE = "postgresql"
DATA_URL = ""
