# ---------------------------------------------------------------------------
# Healthcare ETL QA Crew - copy to .env and fill in. Never commit the
# filled-in file.
# ---------------------------------------------------------------------------
APP_NAME=Healthcare ETL QA Crew
APP_ENV=development
OUTPUT_DIR=outputs
LOG_LEVEL=INFO

# Run profiles
#   false  : live LLM, live warehouse (default)
#   true   : read fixtures only, no network. Labels every artifact DEMO_FIXTURE.
DEMO_MODE=false

# How pipeline inputs are sourced.
#   fixture  : read the star schema from ./fixtures/datasets (default)
#   live     : read table metadata + row samples through SQLAlchemy
#              (requires DATA_ENGINE/DATA_URL below)
DATA_SOURCE_MODE=fixture

# ---------------------------------------------------------------------------
# LLM (CrewAI). The model id is configurable on purpose: provider naming
# changes. Any CrewAI-supported "provider/model" string works.
#   DeepSeek : deepseek/deepseek-v4-flash   (LLM_API_KEY = DeepSeek key)
#   Groq     : openai/openai/gpt-oss-120b   (plus LLM_BASE_URL)
#   OpenAI   : openai/gpt-4o-mini
# ---------------------------------------------------------------------------
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8000

# Provider-only body keys forwarded on every request as extra_body.
# DeepSeek's reasoning models (deepseek-v4-pro) spend the whole token budget
# on chain-of-thought unless thinking is disabled:
LLM_EXTRA_BODY_JSON={"thinking":{"type":"disabled"}}

# How structured output is requested:
#   auto   detect from the provider's error, then remember (default)
#   schema always ask the provider to enforce the JSON schema
#   prompt never ask; put the schema in the prompt and validate locally
# DeepSeek cannot enforce JSON schemas, so LLM_STRUCTURED_OUTPUT=prompt saves
# one wasted call per run there.
LLM_STRUCTURED_OUTPUT=auto

# ---------------------------------------------------------------------------
# Live data warehouse (optional; used only when DATA_SOURCE_MODE=live).
# Credentials are read-only by convention: the app never writes to the
# warehouse.
# ---------------------------------------------------------------------------
DATA_ENGINE=postgresql
DATA_URL=

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
PIPELINE_MAX_RUNS=20
PIPELINE_MAX_RETRIES=2
PIPELINE_RUN_TIMEOUT_SECONDS=600
PIPELINE_MAX_INPUT_CHARS=4000
